# ${EXTERNAL_SERVER_ORIGIN} и ${SERVER_PORT} подставляет entrypoint nginx (envsubst).
# Остальные $var — переменные nginx; при NGINX_ENVSUBST_FILTER их не трогают.

upstream ssr_client {
    server client:80;
}

upstream app_server {
    server server:${SERVER_PORT};
}

server {
    listen 80;
    server_name _;

    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https: blob:; font-src 'self' data:; connect-src 'self' ${EXTERNAL_SERVER_ORIGIN} https://ya-praktikum.tech https://oauth.yandex.ru https://passport.yandex.ru ws: wss:; object-src 'none'; base-uri 'self'; form-action 'self' https://oauth.yandex.ru https://passport.yandex.ru https://ya-praktikum.tech; frame-ancestors 'self'" always;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    client_max_body_size 10m;

    location /own-api/ {
        proxy_pass http://app_server/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Cookie $http_cookie;
    }

    location / {
        proxy_pass http://ssr_client;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Cookie $http_cookie;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }
}
