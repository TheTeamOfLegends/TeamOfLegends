# =============================================================================
# Шаблон переменных окружения (ТОЛЬКО локальные/тестовые значения).
# Реальные секреты и прод-пароли сюда не класть и в git не коммитить.
#
# Перед первым стартом: `node init.js` или `cp .env.sample .env`, затем поправьте
# значения в локальном `.env` (файл в .gitignore).
# =============================================================================

CLIENT_PORT=3000
SERVER_PORT=3001

# --- Postgres (тестовые креды для локальной разработки) ---
POSTGRES_USER=postgres
# Спецсимволы ($ # !) — только в кавычках, иначе docker compose съест $VAR
POSTGRES_PASSWORD="change_me_strong_password"
POSTGRES_DB=postgres
# Порт Postgres внутри контейнера / в docker-сети (всегда 5432)
POSTGRES_PORT=5432
# Порт на хосте (чтобы не конфликтовать с локальным Postgres на 5432)
POSTGRES_EXTERNAL_PORT=5441
# localhost — API на хосте; в docker compose для server → hostname `postgres`
POSTGRES_HOST=localhost

# Если API запускаете на хосте (`yarn dev:server`), а Postgres в Docker:
#   POSTGRES_HOST=localhost
#   POSTGRES_PORT=5441   # = POSTGRES_EXTERNAL_PORT
# В docker compose у server POSTGRES_HOST/PORT переопределяются на postgres:5432

# --- URL / домен (прод на Yandex Cloud) ---
EXTERNAL_SERVER_URL=https://your-app.ya-praktikum.tech
INTERNAL_SERVER_URL=http://server:3001
# Имя хоста для nginx server_name и пути к сертификатам Let's Encrypt
DOMAIN_NAME=your-app.ya-praktikum.tech

# Content-Security-Policy: источники для fetch/XHR (без кавычек вокруг self — их добавит сервер)
# Прод: origin своего API обычно совпадает с EXTERNAL_SERVER_URL без path
CSP_CONNECT_SRC=https://ya-praktikum.tech,https://oauth.yandex.ru,https://passport.yandex.ru,ws:,wss:
# Куда можно уводить формой / OAuth redirect
CSP_FORM_ACTION=https://oauth.yandex.ru,https://passport.yandex.ru,https://ya-praktikum.tech
