# =============================================================================
# Шаблон переменных окружения (ТОЛЬКО локальные/тестовые значения).
# Реальные секреты и прод-пароли сюда не класть и в git не коммитить.
#
# Перед стартом: `node init.js` или `cp .env.sample .env`, затем при необходимости
# поправьте значения в локальном `.env` (файл в .gitignore).
# =============================================================================

CLIENT_PORT=3000
SERVER_PORT=3001

# --- Postgres (тестовые креды для локальной разработки) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
POSTGRES_PORT=5432
# localhost — API на хосте, Postgres в Docker
# В docker compose для сервиса server переопределяется на hostname `postgres`
POSTGRES_HOST=localhost

# --- URL API ---
EXTERNAL_SERVER_URL=http://localhost:3001
INTERNAL_SERVER_URL=http://server:3001
